import Markov.StandardCircleSquareScalar
import Markov.PaperQuadrilateralSquareChart

noncomputable section
namespace Markov

/-- Ordinary opposite-edge steps on the closed square with its corners removed. -/
def standardSquareOppositeEdgeStep (p q : paperPuncturedSquare) : Prop :=
  (p.1.1 = q.1.1 ∧ ((p.1.2 = -1 ∧ q.1.2 = 1) ∨ (p.1.2 = 1 ∧ q.1.2 = -1))) ∨
  (p.1.2 = q.1.2 ∧ ((p.1.1 = -1 ∧ q.1.1 = 1) ∨ (p.1.1 = 1 ∧ q.1.1 = -1)))

/-- The equivalence relation generated by ordinary opposite-edge steps. -/
def standardSquareOppositeEdgeRel : paperPuncturedSquare → paperPuncturedSquare → Prop :=
  Relation.EqvGen standardSquareOppositeEdgeStep

/-- The standard opposite-edge quotient setoid on the punctured square. -/
def standardSquareOppositeEdgeSetoid : Setoid paperPuncturedSquare :=
  Relation.EqvGen.setoid standardSquareOppositeEdgeStep

/-- Every direct edge step preserves the pair of standard circle classes. -/
theorem standardSquareOppositeEdgeStep_scalar_eq {p q : paperPuncturedSquare}
    (h : standardSquareOppositeEdgeStep p q) :
    (standardCircleSquareScalar p.1.1, standardCircleSquareScalar p.1.2) =
      (standardCircleSquareScalar q.1.1, standardCircleSquareScalar q.1.2) := by
  rcases h with ⟨ha, hb⟩ | ⟨hb, ha⟩
  · apply Prod.ext
    · rw [ha]
    · rcases hb with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
        rw [h1, h2, standardCircleSquareScalar_neg_one, standardCircleSquareScalar_one]
  · apply Prod.ext
    · rcases ha with ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
        rw [h1, h2, standardCircleSquareScalar_neg_one, standardCircleSquareScalar_one]
    · rw [hb]

/-- Generated edge equivalence preserves the pair of standard circle classes. -/
theorem standardSquareOppositeEdgeRel_scalar_eq {p q : paperPuncturedSquare}
    (h : standardSquareOppositeEdgeRel p q) :
    (standardCircleSquareScalar p.1.1, standardCircleSquareScalar p.1.2) =
      (standardCircleSquareScalar q.1.1, standardCircleSquareScalar q.1.2) := by
  induction h with
  | rel p q h => exact standardSquareOppositeEdgeStep_scalar_eq h
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih1 ih2 => exact ih1.trans ih2

/-- Pair equality of circle classes gives precisely the standard edge equivalence. -/
theorem standardSquare_scalar_kernel_iff (p q : paperPuncturedSquare) :
    (standardCircleSquareScalar p.1.1, standardCircleSquareScalar p.1.2) =
      (standardCircleSquareScalar q.1.1, standardCircleSquareScalar q.1.2) ↔
        standardSquareOppositeEdgeRel p q := by
  constructor
  · intro h
    have ha := (standardCircleSquareScalar_eq_iff (abs_le.mp p.2.1)
      (abs_le.mp q.2.1)).mp (congrArg Prod.fst h)
    have hb := (standardCircleSquareScalar_eq_iff (abs_le.mp p.2.2.1)
      (abs_le.mp q.2.2.1)).mp (congrArg Prod.snd h)
    rcases ha with ha | ⟨ha1, ha2⟩ | ⟨ha1, ha2⟩
    · rcases hb with hb | ⟨hb1, hb2⟩ | ⟨hb1, hb2⟩
      · have heq : p = q := Subtype.ext (Prod.ext ha hb)
        subst q
        exact Relation.EqvGen.refl p
      · exact Relation.EqvGen.rel _ _ (Or.inl ⟨ha, Or.inl ⟨hb1, hb2⟩⟩)
      · exact Relation.EqvGen.rel _ _ (Or.inl ⟨ha, Or.inr ⟨hb1, hb2⟩⟩)
    · rcases hb with hb | ⟨hb1, _⟩ | ⟨hb1, _⟩
      · exact Relation.EqvGen.rel _ _ (Or.inr ⟨hb, Or.inl ⟨ha1, ha2⟩⟩)
      · have hs := p.2.2.2
        rw [ha1, hb1] at hs
        norm_num at hs
      · have hs := p.2.2.2
        rw [ha1, hb1] at hs
        norm_num at hs
    · rcases hb with hb | ⟨hb1, _⟩ | ⟨hb1, _⟩
      · exact Relation.EqvGen.rel _ _ (Or.inr ⟨hb, Or.inr ⟨ha1, ha2⟩⟩)
      · have hs := p.2.2.2
        rw [ha1, hb1] at hs
        norm_num at hs
      · have hs := p.2.2.2
        rw [ha1, hb1] at hs
        norm_num at hs
  · exact standardSquareOppositeEdgeRel_scalar_eq

end Markov
