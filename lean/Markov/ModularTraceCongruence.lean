import Markov.ModularTraceQuotient
import Mathlib.Data.ZMod.Basic

/-! Finite congruence certificates for the actual subgroup generated by the
trace matrices. All finite calculations are checked by kernel reduction. -/

namespace Markov

/-- Entrywise reduction of an integral two-by-two matrix. -/
def traceMatrixReduction (N : ℕ) :
    IntMatrixTwo →+* Matrix (Fin 2) (Fin 2) (ZMod N) :=
  (Int.castRingHom (ZMod N)).mapMatrix

theorem traceMatrixReduction_trace (N : ℕ) (M : IntMatrixTwo) :
    (traceMatrixReduction N M).trace = (M.trace : ZMod N) := by
  simp [traceMatrixReduction, RingHom.mapMatrix_apply, Matrix.trace, Matrix.diag_apply]

/-- A twelve-element matrix group containing both reduced trace seeds. -/
def traceModFourImage : Finset (Matrix (Fin 2) (Fin 2) (ZMod 4)) :=
  { !![0, 1; 3, 3], !![0, 3; 1, 3], !![1, 0; 0, 1],
    !![1, 1; 1, 2], !![1, 2; 2, 1], !![1, 3; 3, 2],
    !![2, 1; 1, 1], !![2, 3; 3, 1], !![3, 0; 2, 3],
    !![3, 1; 3, 0], !![3, 2; 0, 3], !![3, 3; 1, 0] }

theorem traceModFourImage_one :
    (1 : Matrix (Fin 2) (Fin 2) (ZMod 4)) ∈ traceModFourImage := by decide

theorem traceModFourImage_mul :
    ∀ a ∈ traceModFourImage, ∀ b ∈ traceModFourImage,
      a * b ∈ traceModFourImage := by
  simp only [traceModFourImage, Finset.mem_insert, Finset.mem_singleton,
    forall_eq_or_imp, forall_eq]
  repeat' apply And.intro
  all_goals decide

theorem traceModFourImage_adjugate :
    ∀ a ∈ traceModFourImage, a.adjugate ∈ traceModFourImage := by
  simp only [traceModFourImage, Finset.mem_insert, Finset.mem_singleton,
    forall_eq_or_imp, forall_eq]
  repeat' apply And.intro
  all_goals decide

theorem traceModFourImage_neg_one :
    (-1 : Matrix (Fin 2) (Fin 2) (ZMod 4)) ∉ traceModFourImage := by decide

theorem traceModFourImage_trace :
    ∀ a ∈ traceModFourImage, a.trace = 2 ∨ a.trace = 3 := by
  simp only [traceModFourImage, Finset.mem_insert, Finset.mem_singleton,
    forall_eq_or_imp, forall_eq]
  decide

/-- The inverse image of the certified finite matrix group. -/
def traceModFourPreimage : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℤ) where
  carrier := {g | traceMatrixReduction 4 (g : IntMatrixTwo) ∈ traceModFourImage}
  one_mem' := by
    change traceMatrixReduction 4 1 ∈ traceModFourImage
    simpa only [map_one] using traceModFourImage_one
  mul_mem' := by
    intro a b ha hb
    change traceMatrixReduction 4 ((a : IntMatrixTwo) * (b : IntMatrixTwo)) ∈
      traceModFourImage
    rw [map_mul]
    exact traceModFourImage_mul _ ha _ hb
  inv_mem' := by
    intro a ha
    change traceMatrixReduction 4 (a : IntMatrixTwo).adjugate ∈ traceModFourImage
    rw [traceMatrixReduction, RingHom.map_adjugate]
    exact traceModFourImage_adjugate _ ha

theorem modularTraceSubgroup_le_traceModFourPreimage :
    modularTraceSubgroup ≤ traceModFourPreimage := by
  apply (modularTraceSubgroup_le_iff _).mpr
  constructor
  · change traceMatrixReduction 4 modularGeneratorA ∈ traceModFourImage
    decide
  · change traceMatrixReduction 4 modularGeneratorB ∈ traceModFourImage
    decide

theorem modularTraceSubgroup_reduction_four_mem
    (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) (hg : g ∈ modularTraceSubgroup) :
    traceMatrixReduction 4 (g : IntMatrixTwo) ∈ traceModFourImage :=
  modularTraceSubgroup_le_traceModFourPreimage hg

/-- The generated integral subgroup does not contain the central matrix `-I`. -/
theorem neg_one_not_mem_modularTraceSubgroup :
    (-1 : Matrix.SpecialLinearGroup (Fin 2) ℤ) ∉ modularTraceSubgroup := by
  intro h
  have hm := modularTraceSubgroup_reduction_four_mem (-1) h
  apply traceModFourImage_neg_one
  simpa only [Matrix.SpecialLinearGroup.coe_neg, Matrix.SpecialLinearGroup.coe_one,
    map_neg, map_one] using hm

theorem modularTraceSubgroup_trace_ne_zero
    (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) (hg : g ∈ modularTraceSubgroup) :
    (g : IntMatrixTwo).trace ≠ 0 := by
  intro ht
  have hc := traceModFourImage_trace _ (modularTraceSubgroup_reduction_four_mem g hg)
  rw [traceMatrixReduction_trace, ht] at hc
  exact (by decide : ¬ ((0 : ZMod 4) = 2 ∨ (0 : ZMod 4) = 3)) hc

theorem modularTraceSubgroup_trace_ne_one
    (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) (hg : g ∈ modularTraceSubgroup) :
    (g : IntMatrixTwo).trace ≠ 1 := by
  intro ht
  have hc := traceModFourImage_trace _ (modularTraceSubgroup_reduction_four_mem g hg)
  rw [traceMatrixReduction_trace, ht] at hc
  exact (by decide : ¬ ((1 : ZMod 4) = 2 ∨ (1 : ZMod 4) = 3)) hc

/-- The eight-element reduction modulo three of the seed group. -/
def traceModThreeImage : Finset (Matrix (Fin 2) (Fin 2) (ZMod 3)) :=
  { !![0, 1; 2, 0], !![0, 2; 1, 0], !![1, 0; 0, 1], !![1, 1; 1, 2],
    !![1, 2; 2, 2], !![2, 0; 0, 2], !![2, 1; 1, 1], !![2, 2; 2, 1] }

theorem traceModThreeImage_one :
    (1 : Matrix (Fin 2) (Fin 2) (ZMod 3)) ∈ traceModThreeImage := by decide

theorem traceModThreeImage_mul :
    ∀ a ∈ traceModThreeImage, ∀ b ∈ traceModThreeImage,
      a * b ∈ traceModThreeImage := by
  simp only [traceModThreeImage, Finset.mem_insert, Finset.mem_singleton,
    forall_eq_or_imp, forall_eq]
  repeat' apply And.intro
  all_goals decide

theorem traceModThreeImage_adjugate :
    ∀ a ∈ traceModThreeImage, a.adjugate ∈ traceModThreeImage := by
  simp only [traceModThreeImage, Finset.mem_insert, Finset.mem_singleton,
    forall_eq_or_imp, forall_eq]
  repeat' apply And.intro
  all_goals decide

theorem traceModThreeImage_trace_two :
    ∀ a ∈ traceModThreeImage, a.trace = 2 → a = 1 := by
  simp only [traceModThreeImage, Finset.mem_insert, Finset.mem_singleton,
    forall_eq_or_imp, forall_eq]
  decide

def traceModThreePreimage : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℤ) where
  carrier := {g | traceMatrixReduction 3 (g : IntMatrixTwo) ∈ traceModThreeImage}
  one_mem' := by
    change traceMatrixReduction 3 1 ∈ traceModThreeImage
    simpa only [map_one] using traceModThreeImage_one
  mul_mem' := by
    intro a b ha hb
    change traceMatrixReduction 3 ((a : IntMatrixTwo) * (b : IntMatrixTwo)) ∈
      traceModThreeImage
    rw [map_mul]
    exact traceModThreeImage_mul _ ha _ hb
  inv_mem' := by
    intro a ha
    change traceMatrixReduction 3 (a : IntMatrixTwo).adjugate ∈ traceModThreeImage
    rw [traceMatrixReduction, RingHom.map_adjugate]
    exact traceModThreeImage_adjugate _ ha

theorem modularTraceSubgroup_le_traceModThreePreimage :
    modularTraceSubgroup ≤ traceModThreePreimage := by
  apply (modularTraceSubgroup_le_iff _).mpr
  constructor
  · change traceMatrixReduction 3 modularGeneratorA ∈ traceModThreeImage
    decide
  · change traceMatrixReduction 3 modularGeneratorB ∈ traceModThreeImage
    decide

theorem modularTraceSubgroup_reduction_three_mem
    (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) (hg : g ∈ modularTraceSubgroup) :
    traceMatrixReduction 3 (g : IntMatrixTwo) ∈ traceModThreeImage :=
  modularTraceSubgroup_le_traceModThreePreimage hg

/-- A determinant-one integral matrix congruent to `I` modulo three cannot
have trace `-1`: the determinant equation would make three divide one. -/
theorem trace_ne_neg_one_of_reduction_three_eq_one (M : IntMatrixTwo)
    (hdet : M.det = 1) (hred : traceMatrixReduction 3 M = 1) :
    M.trace ≠ -1 := by
  intro ht
  have h00 : (M 0 0 : ZMod 3) = 1 := by
    have h := congr_fun (congr_fun hred 0) 0
    simpa [traceMatrixReduction, RingHom.mapMatrix_apply] using h
  have h01 : (M 0 1 : ZMod 3) = 0 := by
    have h := congr_fun (congr_fun hred 0) 1
    simpa [traceMatrixReduction, RingHom.mapMatrix_apply] using h
  have h10 : (M 1 0 : ZMod 3) = 0 := by
    have h := congr_fun (congr_fun hred 1) 0
    simpa [traceMatrixReduction, RingHom.mapMatrix_apply] using h
  have h11 : (M 1 1 : ZMod 3) = 1 := by
    have h := congr_fun (congr_fun hred 1) 1
    simpa [traceMatrixReduction, RingHom.mapMatrix_apply] using h
  have ha : (3 : ℤ) ∣ M 0 0 - 1 := by
    apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ 3).mp
    push_cast
    rw [h00, sub_self]
  have hd : (3 : ℤ) ∣ M 1 1 - 1 := by
    apply (ZMod.intCast_zmod_eq_zero_iff_dvd _ 3).mp
    push_cast
    rw [h11, sub_self]
  obtain ⟨a, ha⟩ := ha
  obtain ⟨b, hb⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd _ 3).mp h01
  obtain ⟨c, hc⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd _ 3).mp h10
  obtain ⟨d, hd⟩ := hd
  have haa : M 0 0 = 1 + 3 * a := by omega
  have hdd : M 1 1 = 1 + 3 * d := by omega
  simp only [Matrix.det_fin_two, haa, hb, hc, hdd] at hdet
  norm_num at hdet
  simp only [Matrix.trace, Matrix.diag_apply, Fin.sum_univ_two, haa, hdd] at ht
  have heq : 3 * (a * d - b * c) = 1 := by nlinarith
  omega

theorem modularTraceSubgroup_trace_ne_neg_one
    (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) (hg : g ∈ modularTraceSubgroup) :
    (g : IntMatrixTwo).trace ≠ -1 := by
  intro ht
  have hmem := modularTraceSubgroup_reduction_three_mem g hg
  have htrace : (traceMatrixReduction 3 (g : IntMatrixTwo)).trace = 2 := by
    rw [traceMatrixReduction_trace, ht]
    decide
  have hred := traceModThreeImage_trace_two _ hmem htrace
  exact trace_ne_neg_one_of_reduction_three_eq_one _ g.property hred ht

/-- No element of the actual seed subgroup has an elliptic integral trace. -/
theorem modularTraceSubgroup_trace_not_elliptic
    (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) (hg : g ∈ modularTraceSubgroup) :
    (g : IntMatrixTwo).trace ≠ -1 ∧ (g : IntMatrixTwo).trace ≠ 0 ∧
      (g : IntMatrixTwo).trace ≠ 1 :=
  ⟨modularTraceSubgroup_trace_ne_neg_one g hg,
    modularTraceSubgroup_trace_ne_zero g hg, modularTraceSubgroup_trace_ne_one g hg⟩

theorem modularTraceSubgroup_trace_abs_ge_two
    (g : Matrix.SpecialLinearGroup (Fin 2) ℤ) (hg : g ∈ modularTraceSubgroup) :
    2 ≤ |(g : IntMatrixTwo).trace| := by
  have h := modularTraceSubgroup_trace_not_elliptic g hg
  rcases le_total 0 (g : IntMatrixTwo).trace with ht | ht
  · rw [abs_of_nonneg ht]
    omega
  · rw [abs_of_nonpos ht]
    omega

end Markov
