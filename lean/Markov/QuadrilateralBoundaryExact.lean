import Markov.QuadrilateralReturns
import Markov.PaperQuadrilateralSideRelation

noncomputable section
open scoped MatrixGroups
namespace Markov

private theorem paperQuadrilateral_neg_mul (a b : SL(2, ℤ)) : (-a) * b = -(a * b) := by
  apply Subtype.ext
  change -(a : Matrix (Fin 2) (Fin 2) ℤ) * (b : Matrix (Fin 2) (Fin 2) ℤ) =
    -((a : Matrix (Fin 2) (Fin 2) ℤ) * (b : Matrix (Fin 2) (Fin 2) ℤ))
  exact neg_mul _ _

theorem modularTraceSubgroup_neg_not_mem {g : SL(2, ℤ)}
    (hg : g ∈ modularTraceSubgroup) : -g ∉ modularTraceSubgroup := by
  intro hneg
  apply neg_one_not_mem_modularTraceSubgroup
  have h := modularTraceSubgroup.mul_mem hneg (modularTraceSubgroup.inv_mem hg)
  simpa only [paperQuadrilateral_neg_mul, mul_inv_cancel] using h

def paperQuadrilateralSideReturnWordAt : Fin 5 → SL(2, ℤ) :=
  ![1, paperGeneratorASL, paperGeneratorASL⁻¹, paperGeneratorBSL, paperGeneratorBSL⁻¹]

theorem paperQuadrilateralSideReturnWordAt_mem (i : Fin 5) :
    paperQuadrilateralSideReturnWordAt i ∈ modularTraceSubgroup := by
  have hA : paperGeneratorASL ∈ modularTraceSubgroup := by
    rw [← paperTraceSubgroup_eq_modularTraceSubgroup]
    exact paperGeneratorASL_mem_paperTraceSubgroup
  have hB : paperGeneratorBSL ∈ modularTraceSubgroup := by
    rw [← paperTraceSubgroup_eq_modularTraceSubgroup]
    exact paperGeneratorBSL_mem_paperTraceSubgroup
  fin_cases i
  · exact modularTraceSubgroup.one_mem
  · exact hA
  · exact modularTraceSubgroup.inv_mem hA
  · exact hB
  · exact modularTraceSubgroup.inv_mem hB

/-- The only actual subgroup matrices returning a point of the literal Q to Q
are identity and the four original paper A/B side-pairing matrices. -/
theorem paperIdealQuadrilateral_return_word (g : SL(2, ℤ))
    (hg : g ∈ modularTraceSubgroup) (z : UpperHalfPlane)
    (hz : z ∈ paperIdealQuadrilateral) (hgz : g • z ∈ paperIdealQuadrilateral) :
    ∃ i : Fin 5, g = paperQuadrilateralSideReturnWordAt i := by
  obtain ⟨l, hl⟩ := paperIdealQuadrilateral_signed_return_candidate g hg z hz hgz
  have hret : paperQuadrilateralReturnCandidateAt l • z ∈ paperIdealQuadrilateral := by
    rcases hl with hl | hl
    · simpa only [hl] using hgz
    · simpa only [hl, ModularGroup.SL_neg_smul] using hgz
  have hpos (a : SL(2, ℤ)) (ha : a ∈ modularTraceSubgroup)
      (hga : g = a ∨ g = -a) : g = a := by
    apply hga.resolve_right
    intro h
    exact modularTraceSubgroup_neg_not_mem ha (h ▸ hg)
  fin_cases l
  · exact ⟨0, hpos _ (paperQuadrilateralSideReturnWordAt_mem 0) hl⟩
  · exact ⟨1, hpos _ (paperQuadrilateralSideReturnWordAt_mem 1) hl⟩
  · exact ⟨2, hpos _ (paperQuadrilateralSideReturnWordAt_mem 2) hl⟩
  · exact ⟨3, hpos _ (paperQuadrilateralSideReturnWordAt_mem 3) hl⟩
  · exact ⟨4, hpos _ (paperQuadrilateralSideReturnWordAt_mem 4) hl⟩
  · exact (paperIdealQuadrilateral_T_three_S_not_mem z hz hret).elim
  · exact (paperIdealQuadrilateral_T_three_inv_S_not_mem z hz (by
      simpa only [paperQuadrilateralReturnCandidateAt, Matrix.cons_val,
        Matrix.cons_val_zero, Matrix.cons_val_one, Fin.reduceFinMk, inv_pow] using hret)).elim
  · exact (paperIdealQuadrilateral_S_T_three_not_mem z hz hret).elim
  · exact (paperIdealQuadrilateral_S_T_three_inv_not_mem z hz (by
      simpa only [paperQuadrilateralReturnCandidateAt, Matrix.cons_val,
        Matrix.cons_val_zero, Matrix.cons_val_one, Fin.reduceFinMk, inv_pow] using hret)).elim

/-- Exact boundary identification: the kernel of the actual orbit projection
is precisely the equivalence generated by the original A/B side pairings. -/
theorem paperQuadrilateral_quotient_eq_iff_sideRel (z w : paperIdealQuadrilateral) :
    paperQuadrilateralQuotientMap z = paperQuadrilateralQuotientMap w ↔
      PaperQuadrilateralSideRel z w := by
  constructor
  · intro heq
    obtain ⟨g, hg⟩ := (modularTraceQuotientMk_eq_iff w.val z.val).mp heq.symm
    have hg' : g.val • z.val = w.val := hg
    obtain ⟨i, hi⟩ := paperIdealQuadrilateral_return_word g.val g.property z.val z.property
      (hg'.symm ▸ w.property)
    rw [hi] at hg'
    fin_cases i
    · exact paperQuadrilateralSideRel_of_eq (by simpa only [one_smul] using
        (show (1 : SL(2, ℤ)) • z.val = w.val from hg'))
    · exact paperQuadrilateralSideRel_of_A hg'
    · exact paperQuadrilateralSideRel_of_A_inv hg'
    · exact paperQuadrilateralSideRel_of_B hg'
    · exact paperQuadrilateralSideRel_of_B_inv hg'
  · exact paperQuadrilateralSideRel_quotient_eq

theorem paperQuadrilateralSideSetoid_eq_boundarySetoid :
    paperQuadrilateralSideSetoid = paperQuadrilateralBoundarySetoid := by
  apply Setoid.ext
  intro z w
  exact (paperQuadrilateral_quotient_eq_iff_sideRel z w).symm

end Markov
