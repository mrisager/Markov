import Markov.PaperSeedConjugacy
import Markov.ModularTraceAction
import Mathlib.LinearAlgebra.Matrix.ProjectiveSpecialLinearGroup
import Mathlib.Algebra.Group.Subgroup.Map
import Mathlib.Topology.Covering.Quotient

/-! The upper-half-plane orbit quotient by the two integral trace
generators, equipped with the orbit-quotient topology. Seed conjugacy
identifies the generated subgroups. `PaperActualPuncturedTorus` identifies
the quotient with the punctured torus. -/

noncomputable section
open scoped MatrixGroups
namespace Markov

/-- The actual special-linear subgroup generated by the two trace matrices. -/
def modularTraceSubgroup : Subgroup SL(2, ℤ) :=
  Subgroup.closure {modularGeneratorASL, modularGeneratorBSL}

/-- The actual special-linear subgroup generated by the paper's marked seeds. -/
def paperTraceSubgroup : Subgroup SL(2, ℤ) :=
  Subgroup.closure {paperGeneratorASL, paperGeneratorBSL}

theorem modularGeneratorASL_mem_modularTraceSubgroup :
    modularGeneratorASL ∈ modularTraceSubgroup :=
  Subgroup.subset_closure (by simp)

theorem modularGeneratorBSL_mem_modularTraceSubgroup :
    modularGeneratorBSL ∈ modularTraceSubgroup :=
  Subgroup.subset_closure (by simp)

theorem modularTraceSubgroup_le_iff (Γ : Subgroup SL(2, ℤ)) :
    modularTraceSubgroup ≤ Γ ↔ modularGeneratorASL ∈ Γ ∧ modularGeneratorBSL ∈ Γ := by
  constructor
  · intro h
    exact ⟨h modularGeneratorASL_mem_modularTraceSubgroup,
      h modularGeneratorBSL_mem_modularTraceSubgroup⟩
  · intro h
    apply (Subgroup.closure_le Γ).mpr
    intro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    rcases hg with rfl | rfl
    · exact h.1
    · exact h.2

/-- Simultaneous seed conjugacy carries the entire generated paper subgroup
to the actual trace subgroup, not merely its two generating matrices. -/
theorem paperTraceSubgroup_map_conjugation :
    paperTraceSubgroup.map paperSeedConjugation.toMonoidHom = modularTraceSubgroup := by
  unfold paperTraceSubgroup modularTraceSubgroup
  rw [MonoidHom.map_closure]
  rw [Set.image_pair]
  simp only [MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe,
    paperSeedConjugation_paperA, paperSeedConjugation_paperB]

theorem mem_modularTraceSubgroup_conjugate_iff (g : SL(2, ℤ)) :
    paperSeedConjugation g ∈ modularTraceSubgroup ↔ g ∈ paperTraceSubgroup := by
  rw [← paperTraceSubgroup_map_conjugation]
  constructor
  · intro hg
    obtain ⟨h, hh, heq⟩ := Subgroup.mem_map.mp hg
    have he : h = g := paperSeedConjugation.injective heq
    simpa only [he] using hh
  · intro hg
    exact Subgroup.mem_map.mpr ⟨g, hg, rfl⟩

/-- The actual projective image. No equality with a commutator subgroup or
index calculation is built into this definition. -/
def modularTraceProjectiveSubgroup : Subgroup PSL(2, ℤ) :=
  modularTraceSubgroup.map (QuotientGroup.mk' (Subgroup.center SL(2, ℤ)))

theorem modularTraceSubgroup_isometry (g : modularTraceSubgroup) :
    Isometry (fun z : UpperHalfPlane => g • z) :=
  modularSubgroup_isometry modularTraceSubgroup g

theorem modularTraceSubgroup_dist_invariant (g : modularTraceSubgroup)
    (z w : UpperHalfPlane) : dist (g • z) (g • w) = dist z w :=
  modularSubgroup_dist_invariant modularTraceSubgroup g z w

/-- The actual orbit quotient of the upper half-plane. Its inferred topology
is the quotient topology of this explicitly constructed modular action. -/
abbrev ModularTraceQuotient := Quotient (MulAction.orbitRel modularTraceSubgroup UpperHalfPlane)

/-- The genuine orbit projection onto the actual modular trace quotient. -/
def modularTraceQuotientMk (z : UpperHalfPlane) : ModularTraceQuotient :=
  Quotient.mk _ z

theorem modularTraceQuotientMk_eq_iff (z w : UpperHalfPlane) :
    modularTraceQuotientMk z = modularTraceQuotientMk w ↔
      ∃ g : modularTraceSubgroup, g • w = z :=
  Quotient.eq''

theorem modularTraceQuotientMk_eq_iff_ambient (z w : UpperHalfPlane) :
    modularTraceQuotientMk z = modularTraceQuotientMk w ↔
      ∃ g : SL(2, ℤ), g ∈ modularTraceSubgroup ∧ g • w = z := by
  rw [modularTraceQuotientMk_eq_iff]
  constructor
  · rintro ⟨g, hg⟩
    exact ⟨g.val, g.property, hg⟩
  · rintro ⟨g, hg, hgz⟩
    exact ⟨⟨g, hg⟩, hgz⟩

@[simp] theorem modularTraceQuotientMk_smul (g : modularTraceSubgroup) (z : UpperHalfPlane) :
    modularTraceQuotientMk (g • z) = modularTraceQuotientMk z :=
  (modularTraceQuotientMk_eq_iff _ _).mpr ⟨g, rfl⟩

theorem modularTraceQuotientMk_ambient_smul (g : SL(2, ℤ))
    (hg : g ∈ modularTraceSubgroup) (z : UpperHalfPlane) :
    modularTraceQuotientMk (g • z) = modularTraceQuotientMk z :=
  modularTraceQuotientMk_smul ⟨g, hg⟩ z

theorem modularTraceQuotientMk_surjective : Function.Surjective modularTraceQuotientMk :=
  Quotient.mk_surjective

theorem modularTraceQuotientMk_isOpenQuotientMap :
    IsOpenQuotientMap modularTraceQuotientMk :=
  MulAction.isOpenQuotientMap_quotientMk

theorem modularTraceQuotientMk_continuous : Continuous modularTraceQuotientMk :=
  modularTraceQuotientMk_isOpenQuotientMap.continuous

theorem modularTraceQuotientMk_isOpenMap : IsOpenMap modularTraceQuotientMk :=
  modularTraceQuotientMk_isOpenQuotientMap.isOpenMap

theorem modularTraceQuotientMk_isQuotientMap : Topology.IsQuotientMap modularTraceQuotientMk :=
  modularTraceQuotientMk_isOpenQuotientMap.isQuotientMap

/-- The defining universal map out of the actual orbit quotient. -/
def modularTraceQuotientLift {Y : Type*} (f : UpperHalfPlane → Y)
    (hinv : ∀ (g : modularTraceSubgroup) (z : UpperHalfPlane), f (g • z) = f z) :
    ModularTraceQuotient → Y :=
  Quotient.lift f (by
    intro z w hzw
    obtain ⟨g, hg⟩ := hzw
    rw [← hg, hinv])

@[simp] theorem modularTraceQuotientLift_mk {Y : Type*} (f : UpperHalfPlane → Y)
    (hinv : ∀ (g : modularTraceSubgroup) (z : UpperHalfPlane), f (g • z) = f z)
    (z : UpperHalfPlane) :
    modularTraceQuotientLift f hinv (modularTraceQuotientMk z) = f z := rfl

theorem modularTraceQuotientLift_continuous {Y : Type*} [TopologicalSpace Y]
    (f : UpperHalfPlane → Y)
    (hinv : ∀ (g : modularTraceSubgroup) (z : UpperHalfPlane), f (g • z) = f z)
    (hf : Continuous f) : Continuous (modularTraceQuotientLift f hinv) :=
  continuous_quot_lift _ hf

end Markov
