import Markov.PaperAxisProperEndpointPairings
import Mathlib.Logic.Relation

/-! Genuine one-component connectedness of the CONSTRUCTED actual endpoint
diagram. The literal arc flip and actual quotient-edge pairing generate all
actual tags. No connected-diagram, peripheral-layer or classifier field is used. -/
noncomputable section
open Set Topology
namespace Markov

/-- Actual steps are the two already constructed actual endpoint pairings. -/
def paperAxisProperEndpointStep
    (g : modularTraceSubgroup) (hg : 2 < |(g.val : IntMatrixTwo).trace|) (a : ℝ)
    (t u : paperAxisProperEndpointTag g hg a) : Prop :=
  u = paperAxisProperArcEndpointPair g hg a t ∨ u = paperAxisProperEdgePair g hg a t

/-- Each actual endpoint step can be reversed, from the actual involutions. -/
theorem paperAxisProperEndpointStep_symmetric
    (g : modularTraceSubgroup) (hg : 2 < |(g.val : IntMatrixTwo).trace|) (a : ℝ) :
    Symmetric (paperAxisProperEndpointStep g hg a) := by
  intro t u h
  rcases h with he | he
  · subst u
    exact Or.inl ((paperAxisProperArcEndpointPair_involutive g hg a t).symm)
  · subst u
    exact Or.inr ((paperAxisProperEdgePair_involutive g hg a t).symm)

/-- Alternating the actual arc and edge pairings at a source is EXACTLY the
actual cyclic successor source, including the literal last-to-wrap case. -/
theorem paperAxisProperEndpointTraversal_source_next
    (g : modularTraceSubgroup) (hg : 2 < |(g.val : IntMatrixTwo).trace|) (a : ℝ)
    (i : paperAxisProperArcIndex g hg a) :
    paperAxisProperEdgePair g hg a (paperAxisProperArcEndpointPair g hg a (i,0)) =
      (paperAxisProperArcNextIndex g hg a i,0) := rfl

private theorem diagramConnected_zero_source
    (g : modularTraceSubgroup) (hg : 2 < |(g.val : IntMatrixTwo).trace|) (a : ℝ)
    (hN : 0 < (paperAxisPeriodCutPoints g hg a).card-2) :
    ∀ n : ℕ, ∀ hn : n < (paperAxisPeriodCutPoints g hg a).card-2,
      Relation.ReflTransGen (paperAxisProperEndpointStep g hg a)
        ((⟨0,hN⟩ : paperAxisProperArcIndex g hg a),0)
        ((⟨n,hn⟩ : paperAxisProperArcIndex g hg a),0) := by
  intro n
  induction n with
  | zero => intro hn; exact Relation.ReflTransGen.refl
  | succ n ih =>
      intro hn
      have hprev : n < (paperAxisPeriodCutPoints g hg a).card-2 := by omega
      let i : paperAxisProperArcIndex g hg a := ⟨n,hprev⟩
      have hwalk := (ih hprev).tail
        (show paperAxisProperEndpointStep g hg a (i,0)
          (paperAxisProperArcEndpointPair g hg a (i,0)) from Or.inl rfl)
      have hwalk' := hwalk.tail
        (show paperAxisProperEndpointStep g hg a (paperAxisProperArcEndpointPair g hg a (i,0))
          (paperAxisProperEdgePair g hg a (paperAxisProperArcEndpointPair g hg a (i,0)))
          from Or.inr rfl)
      rw [paperAxisProperEndpointTraversal_source_next] at hwalk'
      have hnext : paperAxisProperArcNextIndex g hg a i = ⟨n+1,hn⟩ := by
        apply Fin.ext
        simp only [paperAxisProperArcNextIndex, i, dif_pos hn]
      exact hnext ▸ hwalk'

private theorem diagramConnected_zero_tag
    (g : modularTraceSubgroup) (hg : 2 < |(g.val : IntMatrixTwo).trace|) (a : ℝ)
    (hN : 0 < (paperAxisPeriodCutPoints g hg a).card-2)
    (t : paperAxisProperEndpointTag g hg a) :
    Relation.ReflTransGen (paperAxisProperEndpointStep g hg a)
      ((⟨0,hN⟩ : paperAxisProperArcIndex g hg a),0) t := by
  rcases t with ⟨i,e⟩
  have hi := diagramConnected_zero_source g hg a hN i.val i.isLt
  fin_cases e
  · exact hi
  · exact hi.tail (Or.inl rfl)

/-- Every two ACTUAL endpoint tags belong to one component generated by the
actual arc and quotient-edge pairings. This is proved from the literal finite
cyclic traversal, not supplied as a connectivity/classification hypothesis. -/
theorem paperAxisProperEndpoint_pairings_connected
    (g : modularTraceSubgroup) (hg : 2 < |(g.val : IntMatrixTwo).trace|) (a : ℝ)
    (t u : paperAxisProperEndpointTag g hg a) :
    Relation.ReflTransGen (paperAxisProperEndpointStep g hg a) t u := by
  have hN : 0 < (paperAxisPeriodCutPoints g hg a).card-2 :=
    lt_of_le_of_lt (Nat.zero_le t.1.val) t.1.isLt
  have hreverse := Relation.ReflTransGen.symmetric (paperAxisProperEndpointStep_symmetric g hg a)
    (diagramConnected_zero_tag g hg a hN t)
  exact hreverse.trans (diagramConnected_zero_tag g hg a hN u)

/-- A nonempty subset of endpoint tags closed under both pairings
contains every endpoint tag. -/
theorem paperAxisProperEndpoint_pair_closed_subset_eq_univ
    (g : modularTraceSubgroup) (hg : 2 < |(g.val : IntMatrixTwo).trace|) (a : ℝ)
    (S : Set (paperAxisProperEndpointTag g hg a)) (hS : S.Nonempty)
    (hArc : ∀ t ∈ S, paperAxisProperArcEndpointPair g hg a t ∈ S)
    (hEdge : ∀ t ∈ S, paperAxisProperEdgePair g hg a t ∈ S) : S = Set.univ := by
  have hclosed : ∀ {t u : paperAxisProperEndpointTag g hg a},
      Relation.ReflTransGen (paperAxisProperEndpointStep g hg a) t u → t ∈ S → u ∈ S := by
    intro t u hwalk
    induction hwalk with
    | refl => exact id
    | tail hwalk hstep ih =>
        intro ht
        rcases hstep with he | he
        · rw [he]
          exact hArc _ (ih ht)
        · rw [he]
          exact hEdge _ (ih ht)
  obtain ⟨t,ht⟩ := hS
  apply Set.eq_univ_iff_forall.mpr
  intro u
  exact hclosed (paperAxisProperEndpoint_pairings_connected g hg a t u) ht

end Markov
