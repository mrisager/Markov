import Markov.BasedPathAbelianization
import Markov.SingularTriangleEdges

/-! A concrete candidate for the degree-one Hurewicz inverse, built from
actual connecting paths and the actual integral singular chain complex.
It kills genuine two-boundaries and descends by the actual homology cokernel.
Only the stated based-loop normalization is proved here, not an equivalence
or an assertion that singular H1 is generated by selected geometric loops. -/

noncomputable section
open CategoryTheory CategoryTheory.Limits Opposite Simplicial
namespace Markov

variable (X : Type) [TopologicalSpace X] (x : X) (τ : ∀ y : X, Path x y)

/-- The actual based-loop abelianization class assigned to a literal singular edge. -/
def singularEdgeLoopClass (σ : IntegralSingularSimplex X 1) : BasedLoopAbelianGroup X x :=
  basedPathAbelianization X x τ (singularEdgePath X σ)

/-- The integer-factor homomorphism used in the actual chain coproduct. -/
def singularEdgeLoopCoefficient (σ : IntegralSingularSimplex X 1) :
    AddCommGrpCat.of ℤ ⟶ AddCommGrpCat.of (BasedLoopAbelianGroup X x) :=
  AddCommGrpCat.ofHom
    { toFun := fun n => n • singularEdgeLoopClass X x τ σ
      map_zero' := zero_zsmul _
      map_add' := fun _ _ => add_zsmul _ _ _ }

/-- A literal morphism from the actual integral singular one-chain group
into the actual loop-group abelianization, defined by coproduct universality. -/
def singularOneChainToAbelianization :
    (integralSingularChainComplex X).X 1 ⟶ AddCommGrpCat.of (BasedLoopAbelianGroup X x) :=
  Sigma.desc (fun σ : IntegralSingularSimplex X 1 => singularEdgeLoopCoefficient X x τ σ)

theorem singularOneChainToAbelianization_simplex (σ : IntegralSingularSimplex X 1) :
    singularOneChainToAbelianization X x τ (singularSimplexChain X σ) =
      singularEdgeLoopClass X x τ σ := by
  have hh := Sigma.ι_desc (fun σ : IntegralSingularSimplex X 1 =>
    singularEdgeLoopCoefficient X x τ σ) σ
  have he := congrArg (fun f : AddCommGrpCat.of ℤ ⟶
    AddCommGrpCat.of (BasedLoopAbelianGroup X x) => f (1 : ℤ)) hh
  change singularOneChainToAbelianization X x τ (singularSimplexChain X σ) =
    (1 : ℤ) • singularEdgeLoopClass X x τ σ at he
  simpa only [one_zsmul] using he

/-- Literal normalization on every actual oriented path. -/
theorem singularOneChainToAbelianization_path {a b : X} (γ : Path a b) :
    singularOneChainToAbelianization X x τ (singularPathChain X γ) =
      basedPathAbelianization X x τ γ := by
  rw [singularPathChain, singularOneChainToAbelianization_simplex]
  exact basedPathAbelianization_ext X x τ _ _
    (singularEdgePath_path_toContinuousMap X γ)

/-- The actual triangular edge homotopy proves this candidate map kills
the actual differential of each singular two-simplex. -/
theorem singularOneChainToAbelianization_two_boundary (σ : IntegralSingularSimplex X 2) :
    singularOneChainToAbelianization X x τ
      ((integralSingularChainComplex X).d 2 1 (singularSimplexChain X σ)) = 0 := by
  let f : Fin 3 → IntegralSingularSimplex X 1 := fun i =>
    (TopCat.toSSet.obj (TopCat.of X)).map (SimplexCategory.δ i).op σ
  have h := basedPathAbelianization_triangle X x τ
    (singularOrientedFacePath X σ 2) (singularOrientedFacePath X σ 0)
    (singularOrientedFacePath X σ 1) (singularOrientedFacePath_concat_homotopic X σ)
  simp only [singularOrientedFacePath, basedPathAbelianization_cast] at h
  have he : singularEdgeLoopClass X x τ (f 2) + singularEdgeLoopClass X x τ (f 0) =
      singularEdgeLoopClass X x τ (f 1) := h
  rw [singularSimplexChain_boundary_two, map_add, map_sub]
  rw [singularOneChainToAbelianization_simplex X x τ (f 0),
    singularOneChainToAbelianization_simplex X x τ (f 1),
    singularOneChainToAbelianization_simplex X x τ (f 2)]
  change singularEdgeLoopClass X x τ (f 0) - singularEdgeLoopClass X x τ (f 1) +
    singularEdgeLoopClass X x τ (f 2) = 0
  calc
    _ = (singularEdgeLoopClass X x τ (f 2) + singularEdgeLoopClass X x τ (f 0)) -
        singularEdgeLoopClass X x τ (f 1) := by abel
    _ = 0 := sub_eq_zero.mpr he

private theorem integerFactor_eq_zero {A : AddCommGrpCat.{0}} (f : AddCommGrpCat.of ℤ ⟶ A)
    (h : f (1 : ℤ) = 0) : f = 0 := by
  apply AddCommGrpCat.ext
  intro n
  change f n = 0
  have hn : f n = n • f (1 : ℤ) := by
    simpa only [zsmul_eq_mul, mul_one] using map_zsmul f.hom n (1 : ℤ)
  rw [hn, h, smul_zero]

/-- The actual entire two-boundary morphism is annihilated; this is proved
on coproduct generators and integer coefficients, without a generation axiom. -/
theorem singularOneChainToAbelianization_d_two :
    (integralSingularChainComplex X).d 2 1 ≫ singularOneChainToAbelianization X x τ = 0 := by
  apply Sigma.hom_ext
  intro σ
  rw [comp_zero]
  apply integerFactor_eq_zero
  change singularOneChainToAbelianization X x τ
    ((integralSingularChainComplex X).d 2 1 (singularSimplexChain X σ)) = 0
  exact singularOneChainToAbelianization_two_boundary X x τ σ

/-- Descent from singular cycles through the homology cokernel gives
the inverse candidate. `SingularHurewiczInverse` proves the reverse law. -/
def singularHomologyToAbelianization :
    integralSingularH1 X ⟶ AddCommGrpCat.of (BasedLoopAbelianGroup X x) :=
  ((integralSingularChainComplex X).homologyIsCokernel (i := 2) (j := 1)
    ((ComplexShape.down ℕ).prev_eq' (show (ComplexShape.down ℕ).Rel 2 1 from rfl))).desc
      (CokernelCofork.ofπ
        ((integralSingularChainComplex X).iCycles 1 ≫ singularOneChainToAbelianization X x τ)
        (by rw [← Category.assoc, HomologicalComplex.toCycles_i,
          singularOneChainToAbelianization_d_two]))

/-- The actual homology projection followed by descent equals the explicit
cycle-inclusion/one-chain map. -/
theorem singularHomologyToAbelianization_projection :
    (integralSingularChainComplex X).homologyπ 1 ≫ singularHomologyToAbelianization X x τ =
      (integralSingularChainComplex X).iCycles 1 ≫ singularOneChainToAbelianization X x τ := by
  exact Cofork.IsColimit.π_desc
    ((integralSingularChainComplex X).homologyIsCokernel (i := 2) (j := 1)
      ((ComplexShape.down ℕ).prev_eq' (show (ComplexShape.down ℕ).Rel 2 1 from rfl)))

/-- The candidate inverse has the required exact positive normalization
on every actual based loop, for arbitrary actual connecting paths. -/
theorem singularHomologyToAbelianization_loop (γ : Path x x) :
    singularHomologyToAbelianization X x τ (singularLoopClass X γ) =
      loopAbelianClass X x (.mk γ) := by
  have he := congrArg (fun f : (integralSingularChainComplex X).cycles 1 ⟶
    AddCommGrpCat.of (BasedLoopAbelianGroup X x) => f (singularLoopCycle X γ))
      (singularHomologyToAbelianization_projection X x τ)
  change singularHomologyToAbelianization X x τ (singularLoopClass X γ) =
    singularOneChainToAbelianization X x τ
      ((integralSingularChainComplex X).iCycles 1 (singularLoopCycle X γ)) at he
  rw [singularLoopCycle_iCycles, singularOneChainToAbelianization_path,
    basedPathAbelianization_loop] at he
  exact he

/-- Exact normalization after the actual pi1-to-singular-H1 homomorphism. -/
theorem singularHomologyToAbelianization_hurewicz (g : FundamentalGroup X x) :
    singularHomologyToAbelianization X x τ ((singularHurewiczMap X x g).toAdd) =
      Additive.ofMul (Abelianization.of g) := by
  obtain ⟨γ, hγ⟩ := Path.Homotopic.Quotient.mk_surjective g.toPath
  have he : FundamentalGroup.fromPath (.mk γ) = g := hγ
  rw [← he, singularHurewiczMap_loop]
  exact singularHomologyToAbelianization_loop X x τ γ

/-- The proved normalization descends over actual algebraic abelianization. -/
theorem singularHomologyToAbelianization_hurewiczAbelianization
    (a : Abelianization (FundamentalGroup X x)) :
    singularHomologyToAbelianization X x τ
      ((singularHurewiczAbelianization X x a).toAdd) = Additive.ofMul a := by
  refine QuotientGroup.induction_on a ?_
  intro g
  exact singularHomologyToAbelianization_hurewicz X x τ g

/-- The inverse law on based loops and quotient representatives.
`SingularHurewiczInverse` proves the law on arbitrary singular H1. -/
theorem singularHomologyToAbelianization_leftInverse :
    Function.LeftInverse (singularHomologyToAbelianization X x τ)
      (singularHurewiczAbelianizationAdd X x) := by
  intro a
  change singularHomologyToAbelianization X x τ
    ((singularHurewiczAbelianization X x a.toMul).toAdd) = Additive.ofMul a.toMul
  exact singularHomologyToAbelianization_hurewiczAbelianization X x τ a.toMul

end Markov
