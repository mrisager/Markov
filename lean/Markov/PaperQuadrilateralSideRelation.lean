import Markov.PaperQuadrilateralSideReturns
import Markov.PaperQuadrilateralQuotient

noncomputable section
open scoped MatrixGroups
namespace Markov

/-- The literal paper A/B side-pairing steps, with their actual source sides. -/
def PaperQuadrilateralSideStep (z w : paperIdealQuadrilateral) : Prop :=
  (z.val ∈ paperRightVerticalSide ∧ paperGeneratorASL • z.val = w.val) ∨
  (z.val ∈ paperLeftVerticalSide ∧ paperGeneratorBSL • z.val = w.val)

/-- The equivalence relation generated by the original A/B side pairings. -/
def PaperQuadrilateralSideRel : paperIdealQuadrilateral → paperIdealQuadrilateral → Prop :=
  Relation.EqvGen PaperQuadrilateralSideStep

def paperQuadrilateralSideSetoid : Setoid paperIdealQuadrilateral :=
  Relation.EqvGen.setoid PaperQuadrilateralSideStep

theorem paperQuadrilateralSideStep_quotient_eq {z w : paperIdealQuadrilateral}
    (h : PaperQuadrilateralSideStep z w) :
    paperQuadrilateralQuotientMap z = paperQuadrilateralQuotientMap w := by
  rcases h with ⟨_, hact⟩ | ⟨_, hact⟩
  · exact (paperGeneratorA_quotient z.val).symm.trans (congrArg modularTraceQuotientMk hact)
  · exact (paperGeneratorB_quotient z.val).symm.trans (congrArg modularTraceQuotientMk hact)

theorem paperQuadrilateralSideRel_quotient_eq {z w : paperIdealQuadrilateral}
    (h : PaperQuadrilateralSideRel z w) :
    paperQuadrilateralQuotientMap z = paperQuadrilateralQuotientMap w := by
  induction h with
  | rel z w h => exact paperQuadrilateralSideStep_quotient_eq h
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih1 ih2 => exact ih1.trans ih2

theorem paperQuadrilateralSideRel_boundary {z w : paperIdealQuadrilateral}
    (h : PaperQuadrilateralSideRel z w) :
    paperQuadrilateralBoundarySetoid z w :=
  paperQuadrilateralSideRel_quotient_eq h

theorem paperQuadrilateralSideRel_refl (z : paperIdealQuadrilateral) :
    PaperQuadrilateralSideRel z z := Relation.EqvGen.refl z

theorem paperQuadrilateralSideRel_symm {z w : paperIdealQuadrilateral}
    (h : PaperQuadrilateralSideRel z w) : PaperQuadrilateralSideRel w z :=
  Relation.EqvGen.symm _ _ h

theorem paperQuadrilateralSideRel_trans {z w u : paperIdealQuadrilateral}
    (hzw : PaperQuadrilateralSideRel z w) (hwu : PaperQuadrilateralSideRel w u) :
    PaperQuadrilateralSideRel z u := Relation.EqvGen.trans _ _ _ hzw hwu

theorem paperQuadrilateralSideRel_of_eq {z w : paperIdealQuadrilateral}
    (h : z.val = w.val) : PaperQuadrilateralSideRel z w := by
  have heq : z = w := Subtype.ext h
  subst w
  exact paperQuadrilateralSideRel_refl z

theorem paperQuadrilateralSideRel_of_A {z w : paperIdealQuadrilateral}
    (hact : paperGeneratorASL • z.val = w.val) : PaperQuadrilateralSideRel z w := by
  apply Relation.EqvGen.rel
  exact Or.inl ⟨(paperGeneratorA_quadrilateral_return_iff z.val z.property).mp
    (hact.symm ▸ w.property), hact⟩

theorem paperQuadrilateralSideRel_of_B {z w : paperIdealQuadrilateral}
    (hact : paperGeneratorBSL • z.val = w.val) : PaperQuadrilateralSideRel z w := by
  apply Relation.EqvGen.rel
  exact Or.inr ⟨(paperGeneratorB_quadrilateral_return_iff z.val z.property).mp
    (hact.symm ▸ w.property), hact⟩

theorem paperQuadrilateralSideRel_of_A_inv {z w : paperIdealQuadrilateral}
    (hact : paperGeneratorASL⁻¹ • z.val = w.val) : PaperQuadrilateralSideRel z w := by
  apply paperQuadrilateralSideRel_symm
  apply paperQuadrilateralSideRel_of_A
  rw [← hact, smul_inv_smul]

theorem paperQuadrilateralSideRel_of_B_inv {z w : paperIdealQuadrilateral}
    (hact : paperGeneratorBSL⁻¹ • z.val = w.val) : PaperQuadrilateralSideRel z w := by
  apply paperQuadrilateralSideRel_symm
  apply paperQuadrilateralSideRel_of_B
  rw [← hact, smul_inv_smul]

end Markov

