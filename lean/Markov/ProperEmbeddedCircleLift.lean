import Markov.EmbeddedCircleRealLiftInjective
import Markov.EquivariantCurveAxisBounds
import Markov.PrimitiveAxisLeastPeriod

/-! Actual proper embedded full-real circle lifts and exact cyclic deck
translate intersections. Hyperbolicity of the actual monodromy stays explicit;
no planar separation or simplicity of a projected hyperbolic axis is inferred. -/

noncomputable section
open Set Topology
namespace Markov

/-- A genuine hyperbolic deck element has infinite order, by its actual
positive translation action on the checked isometric invariant axis. -/
theorem modularHyperbolic_not_isOfFinOrder (g : modularTraceSubgroup)
    (hg : 2 < |(g.val : IntMatrixTwo).trace|) : ¬ IsOfFinOrder g := by
  intro hf
  obtain ⟨n, hn, hpow⟩ := hf.exists_pow_eq_one
  have he := modularHyperbolicAxis_pow_action g hg (modularClosedGeodesicPeriod g) g
    (modularHyperbolicAxis_action g hg) n 0
  rw [hpow, one_smul, zero_add] at he
  have ht : (0 : ℝ) = (n : ℝ) * modularClosedGeodesicPeriod g :=
    (modularHyperbolicAxis_isometry g hg).injective he
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  exact (ne_of_gt (mul_pos hn' (modularClosedGeodesicPeriod_pos g hg))) ht.symm

/-- Hyperbolicity of the actual forward unit monodromy makes its full-real
circle lift proper; unit equivariance and continuity are already actual theorems. -/
theorem embeddedCircleRealLift_isProperMap_of_hyperbolicDeck
    (q : NormalizedCircle → ModularTraceQuotient) (hq : IsClosedEmbedding q)
    (z : UpperHalfPlane) (hz : modularTraceQuotientMk z = q 0)
    (hD : 2 < |((embeddedCircleRealLiftDeck q hq z hz).val : IntMatrixTwo).trace|) :
    IsProperMap (embeddedCircleRealLift q hq z hz) :=
  modularEquivariantCurve_isProperMap (embeddedCircleRealLiftDeck q hq z hz) hD 1 (by norm_num)
    (embeddedCircleRealLift q hq z hz) (embeddedCircleRealLift q hq z hz).continuous
    (embeddedCircleRealLift_add_one q hq z hz)

/-- The explicit hyperbolicity hypothesis also discharges infinite-order monodromy. -/
theorem embeddedCircleRealLift_injective_of_hyperbolicDeck
    (q : NormalizedCircle → ModularTraceQuotient) (hq : IsClosedEmbedding q)
    (z : UpperHalfPlane) (hz : modularTraceQuotientMk z = q 0)
    (hD : 2 < |((embeddedCircleRealLiftDeck q hq z hz).val : IntMatrixTwo).trace|) :
    Function.Injective (embeddedCircleRealLift q hq z hz) :=
  embeddedCircleRealLift_injective_of_infiniteOrder q hq z hz
    (modularHyperbolic_not_isOfFinOrder _ hD)

/-- The actual real lift is a genuine closed embedding under actual hyperbolic monodromy. -/
theorem embeddedCircleRealLift_isClosedEmbedding_of_hyperbolicDeck
    (q : NormalizedCircle → ModularTraceQuotient) (hq : IsClosedEmbedding q)
    (z : UpperHalfPlane) (hz : modularTraceQuotientMk z = q 0)
    (hD : 2 < |((embeddedCircleRealLiftDeck q hq z hz).val : IntMatrixTwo).trace|) :
    IsClosedEmbedding (embeddedCircleRealLift q hq z hz) :=
  IsClosedEmbedding.of_continuous_injective_isClosedMap
    (embeddedCircleRealLift q hq z hz).continuous
    (embeddedCircleRealLift_injective_of_hyperbolicDeck q hq z hz hD)
    (embeddedCircleRealLift_isProperMap_of_hyperbolicDeck q hq z hz hD).isClosedMap

/-- Exact actual translated-point identification. The parameter difference
is t-s=n because the forward monodromy convention is F(t+1)=D•F(t).
Only embedded projection, integer equivariance and actual free deck action are used. -/
theorem embeddedCircleRealLift_deck_intersection_iff
    (q : NormalizedCircle → ModularTraceQuotient) (hq : IsClosedEmbedding q)
    (z : UpperHalfPlane) (hz : modularTraceQuotientMk z = q 0)
    (h : modularTraceSubgroup) (s t : ℝ) :
    h • embeddedCircleRealLift q hq z hz s = embeddedCircleRealLift q hq z hz t ↔
      ∃ n : ℤ, t-s = (n : ℝ) ∧ h = (embeddedCircleRealLiftDeck q hq z hz)^n := by
  constructor
  · intro he
    have hp : modularTraceQuotientMk (embeddedCircleRealLift q hq z hz t) =
        modularTraceQuotientMk (embeddedCircleRealLift q hq z hz s) := by
      calc
        _ = modularTraceQuotientMk (h • embeddedCircleRealLift q hq z hz s) :=
          congrArg modularTraceQuotientMk he.symm
        _ = _ := modularTraceQuotientMk_smul h _
    obtain ⟨n, hn⟩ := (embeddedCircleRealLift_project_eq_iff q hq z hz t s).mp hp
    have ht : t = s+(n : ℝ) := by linarith
    refine ⟨n, hn, ?_⟩
    apply IsCancelSMul.right_cancel _ _ (embeddedCircleRealLift q hq z hz s)
    exact he.trans ((congrArg (embeddedCircleRealLift q hq z hz) ht).trans
      (embeddedCircleRealLift_add_int q hq z hz n s))
  · rintro ⟨n, hn, rfl⟩
    have ht : t = s+(n : ℝ) := by linarith
    rw [ht]
    exact (embeddedCircleRealLift_add_int q hq z hz n s).symm

/-- An actual deck translate meets the real-lift image exactly when its deck
element lies in the actual cyclic subgroup generated by forward unit monodromy. -/
theorem embeddedCircleRealLift_translated_range_inter_iff
    (q : NormalizedCircle → ModularTraceQuotient) (hq : IsClosedEmbedding q)
    (z : UpperHalfPlane) (hz : modularTraceQuotientMk z = q 0)
    (h : modularTraceSubgroup) :
    (range (fun t : ℝ => h • embeddedCircleRealLift q hq z hz t) ∩
      range (embeddedCircleRealLift q hq z hz)).Nonempty ↔
        h ∈ Subgroup.zpowers (embeddedCircleRealLiftDeck q hq z hz) := by
  constructor
  · rintro ⟨y, ⟨s, hs⟩, ⟨t, ht⟩⟩
    obtain ⟨n, _, hn⟩ := (embeddedCircleRealLift_deck_intersection_iff q hq z hz h s t).mp
      (hs.trans ht.symm)
    exact Subgroup.mem_zpowers_iff.mpr ⟨n, hn.symm⟩
  · intro hh
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hh
    refine ⟨h • embeddedCircleRealLift q hq z hz 0, ⟨0, rfl⟩, ⟨(n : ℝ), ?_⟩⟩
    simpa only [zero_add, hn] using embeddedCircleRealLift_add_int q hq z hz n 0

/-- The actual setwise stabilizer of the full real-lift image is exactly that cyclic subgroup. -/
theorem embeddedCircleRealLift_range_translate_eq_iff
    (q : NormalizedCircle → ModularTraceQuotient) (hq : IsClosedEmbedding q)
    (z : UpperHalfPlane) (hz : modularTraceQuotientMk z = q 0)
    (h : modularTraceSubgroup) :
    range (fun t : ℝ => h • embeddedCircleRealLift q hq z hz t) =
      range (embeddedCircleRealLift q hq z hz) ↔
        h ∈ Subgroup.zpowers (embeddedCircleRealLiftDeck q hq z hz) := by
  constructor
  · intro he
    apply (embeddedCircleRealLift_translated_range_inter_iff q hq z hz h).mp
    refine ⟨embeddedCircleRealLift q hq z hz 0, ?_, ⟨0, rfl⟩⟩
    rw [he]
    exact ⟨0, rfl⟩
  · intro hh
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hh
    ext y
    constructor
    · rintro ⟨s, rfl⟩
      refine ⟨s+(n : ℝ), ?_⟩
      simpa only [hn] using embeddedCircleRealLift_add_int q hq z hz n s
    · rintro ⟨t, rfl⟩
      refine ⟨t-(n : ℝ), ?_⟩
      have he := embeddedCircleRealLift_add_int q hq z hz n (t-(n : ℝ))
      rw [sub_add_cancel, hn] at he
      exact he.symm

/-- Distinct actual cyclic deck cosets give disjoint real-lift translates. -/
theorem embeddedCircleRealLift_translates_disjoint_of_not_mem
    (q : NormalizedCircle → ModularTraceQuotient) (hq : IsClosedEmbedding q)
    (z : UpperHalfPlane) (hz : modularTraceQuotientMk z = q 0)
    (a b : modularTraceSubgroup)
    (hab : b⁻¹*a ∉ Subgroup.zpowers (embeddedCircleRealLiftDeck q hq z hz)) :
    Disjoint (range (fun t : ℝ => a • embeddedCircleRealLift q hq z hz t))
      (range (fun t : ℝ => b • embeddedCircleRealLift q hq z hz t)) := by
  apply Set.disjoint_left.mpr
  rintro y ⟨s, hs⟩ ⟨t, ht⟩
  dsimp only at hs ht
  have he : (b⁻¹*a) • embeddedCircleRealLift q hq z hz s =
      embeddedCircleRealLift q hq z hz t := by
    rw [mul_smul, hs.trans ht.symm, inv_smul_smul]
  obtain ⟨n, _, hn⟩ := (embeddedCircleRealLift_deck_intersection_iff q hq z hz (b⁻¹*a) s t).mp he
  exact hab (Subgroup.mem_zpowers_iff.mpr ⟨n, hn.symm⟩)

/-- In particular, every deck translate outside the actual monodromy cyclic
subgroup is disjoint from the original actual lift image. -/
theorem embeddedCircleRealLift_translate_disjoint_of_not_mem
    (q : NormalizedCircle → ModularTraceQuotient) (hq : IsClosedEmbedding q)
    (z : UpperHalfPlane) (hz : modularTraceQuotientMk z = q 0)
    (h : modularTraceSubgroup)
    (hh : h ∉ Subgroup.zpowers (embeddedCircleRealLiftDeck q hq z hz)) :
    Disjoint (range (fun t : ℝ => h • embeddedCircleRealLift q hq z hz t))
      (range (embeddedCircleRealLift q hq z hz)) := by
  have he := embeddedCircleRealLift_translates_disjoint_of_not_mem q hq z hz h 1
    (by simpa only [inv_one, one_mul] using hh)
  simpa only [one_smul] using he

end Markov
