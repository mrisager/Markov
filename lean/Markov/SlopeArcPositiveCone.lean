import Markov.BoundaryArc
import Markov.CutoffNeighbors
import Markov.NormedPlane

/-! Interior points of an actual slope boundary arc lie on the positive
cone generated by its determinant-one endpoint vectors. This is a statement
in the original normed plane and does not use any symmetry of its norm. -/

noncomputable section

namespace Markov

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The determinant-one inverse matrix gives the two cone coefficients of
an affine slope section. -/
theorem basis_affineLine_eq_intVector_combination_of_det_one
    (B : Module.Basis (Fin 2) ℝ E) (u v : ℤ × ℤ) (hdet : intDet u v = 1)
    (t : ℝ) :
    B 0 + t • B 1 =
      ((v.2 : ℝ) - (v.1 : ℝ) * t) • intVector B u +
      ((u.1 : ℝ) * t - (u.2 : ℝ)) • intVector B v := by
  have hd : (u.1 : ℝ) * (v.2 : ℝ) - (u.2 : ℝ) * (v.1 : ℝ) = 1 := by
    exact_mod_cast hdet
  have hzero : ((v.2 : ℝ) - (v.1 : ℝ) * t) * (u.1 : ℝ) +
      ((u.1 : ℝ) * t - (u.2 : ℝ)) * (v.1 : ℝ) = 1 := by
    nlinarith only [hd]
  have hone : ((v.2 : ℝ) - (v.1 : ℝ) * t) * (u.2 : ℝ) +
      ((u.1 : ℝ) * t - (u.2 : ℝ)) * (v.2 : ℝ) = t := by
    linear_combination t * hd
  symm
  calc
    _ = (((v.2 : ℝ) - (v.1 : ℝ) * t) * (u.1 : ℝ) +
          ((u.1 : ℝ) * t - (u.2 : ℝ)) * (v.1 : ℝ)) • B 0 +
        (((v.2 : ℝ) - (v.1 : ℝ) * t) * (u.2 : ℝ) +
          ((u.1 : ℝ) * t - (u.2 : ℝ)) * (v.2 : ℝ)) • B 1 := by
      simp only [intVector]
      module
    _ = B 0 + t • B 1 := by rw [hzero, hone, one_smul]

/-- Every point of the open slope arc is the normalized positive
combination of its actual integer endpoint vectors. -/
theorem mem_slopeBoundaryArc_exists_pos_intVector_combination
    (B : Module.Basis (Fin 2) ℝ E) (u v : ℤ × ℤ)
    (hu : 0 < u.1) (hv : 0 < v.1) (hdet : intDet u v = 1)
    (x : E) (hx : x ∈ slopeBoundaryArc B (cutoffSlope u) (cutoffSlope v)) :
    ∃ α β : ℝ, 0 < α ∧ 0 < β ∧
      NormedSpace.normalize (α • intVector B u + β • intVector B v) = x := by
  have huR : (0 : ℝ) < u.1 := by exact_mod_cast hu
  have hvR : (0 : ℝ) < v.1 := by exact_mod_cast hv
  have hlo : (u.2 : ℝ) < basisSlope B x * (u.1 : ℝ) :=
    (div_lt_iff₀ huR).mp hx.2.2.1
  have hhi : basisSlope B x * (v.1 : ℝ) < (v.2 : ℝ) :=
    (lt_div_iff₀ hvR).mp hx.2.2.2
  refine ⟨(v.2 : ℝ) - (v.1 : ℝ) * basisSlope B x,
    (u.1 : ℝ) * basisSlope B x - (u.2 : ℝ), ?_, ?_, ?_⟩
  · nlinarith only [hhi]
  · nlinarith only [hlo]
  · rw [← basis_affineLine_eq_intVector_combination_of_det_one B u v hdet]
    exact radialBasisSection_basisSlope B x hx.1 hx.2.1

/-- Consecutiveness in the actual cutoff supplies both the determinant-one
condition and the positive endpoint denominators. -/
theorem consecutiveCutoffSlopes_mem_arc_exists_pos_intVector_combination
    (B : Module.Basis (Fin 2) ℝ E) (H : ℕ) (u v : ℤ × ℤ)
    (h : ConsecutiveCutoffSlopes H u v) (x : E)
    (hx : x ∈ slopeBoundaryArc B (cutoffSlope u) (cutoffSlope v)) :
    ∃ α β : ℝ, 0 < α ∧ 0 < β ∧
      NormedSpace.normalize (α • intVector B u + β • intVector B v) = x := by
  exact mem_slopeBoundaryArc_exists_pos_intVector_combination B u v
    ((mem_cutoffSlopesUpTo H u).mp h.1).1
    ((mem_cutoffSlopesUpTo H v).mp h.2.1).1
    (consecutiveCutoffSlopes_det_and_denominator_sum H u v h).1 x hx

end Markov
