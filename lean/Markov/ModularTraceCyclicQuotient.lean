import Markov.ModularTraceCommutator
import Markov.ModularProjectiveCenter
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-! The actual projective trace quotient is cyclic, generated by the image
of `T`, and that generator has sixth power one. Exact order six requires a
separate lower-bound argument. -/

noncomputable section
open scoped MatrixGroups
namespace Markov

/-- The actual quotient of the projective modular group by the trace image. -/
abbrev ModularTraceProjectiveQuotient := PSL(2, ℤ) ⧸ modularTraceProjectiveSubgroup

/-- The actual integral modular map to the projective trace quotient. -/
def modularTraceProjectiveQuotientMap : SL(2, ℤ) →* ModularTraceProjectiveQuotient :=
  (QuotientGroup.mk' modularTraceProjectiveSubgroup).comp modularIntegralProjectivization

def modularTraceProjectiveQuotientS : ModularTraceProjectiveQuotient :=
  modularTraceProjectiveQuotientMap ModularGroup.S

def modularTraceProjectiveQuotientT : ModularTraceProjectiveQuotient :=
  modularTraceProjectiveQuotientMap ModularGroup.T

theorem modularTraceProjectiveQuotientMap_surjective :
    Function.Surjective modularTraceProjectiveQuotientMap :=
  (QuotientGroup.mk'_surjective modularTraceProjectiveSubgroup).comp
    (QuotientGroup.mk'_surjective (Subgroup.center SL(2, ℤ)))

instance modularTraceProjectiveQuotient_commutative :
    Std.Commutative (· * · : ModularTraceProjectiveQuotient → _ → _) := by
  apply Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr
  rw [modularTraceProjectiveSubgroup_eq_commutator]

theorem modularTraceProjectiveQuotientMap_neg_one :
    modularTraceProjectiveQuotientMap (-1) = 1 := by
  have h : modularIntegralProjectivization (-1) = 1 := by
    apply (QuotientGroup.eq_one_iff _).mpr
    exact (modularInteger_mem_center_iff _).mpr (Or.inr rfl)
  change (QuotientGroup.mk' modularTraceProjectiveSubgroup)
    (modularIntegralProjectivization (-1)) = 1
  rw [h, map_one]

theorem modularIntegral_S_pow_two : ModularGroup.S ^ 2 = -1 := by
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [pow_two, Matrix.SpecialLinearGroup.coe_mul,
      Matrix.SpecialLinearGroup.coe_neg, Matrix.SpecialLinearGroup.coe_one,
      ModularGroup.coe_S, Matrix.mul_apply, Fin.sum_univ_two]

theorem modularIntegral_ST_pow_three : (ModularGroup.S * ModularGroup.T) ^ 3 = -1 := by
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [pow_succ, Matrix.SpecialLinearGroup.coe_mul,
      Matrix.SpecialLinearGroup.coe_neg, Matrix.SpecialLinearGroup.coe_one,
      ModularGroup.coe_S, ModularGroup.coe_T, Matrix.mul_apply, Fin.sum_univ_two]

theorem modularTraceProjectiveQuotientS_pow_two :
    modularTraceProjectiveQuotientS ^ 2 = 1 := by
  change (modularTraceProjectiveQuotientMap ModularGroup.S) ^ 2 = 1
  rw [← map_pow, modularIntegral_S_pow_two, modularTraceProjectiveQuotientMap_neg_one]

theorem modularTraceProjectiveQuotientST_pow_three :
    (modularTraceProjectiveQuotientS * modularTraceProjectiveQuotientT) ^ 3 = 1 := by
  change (modularTraceProjectiveQuotientMap ModularGroup.S *
    modularTraceProjectiveQuotientMap ModularGroup.T) ^ 3 = 1
  rw [← map_mul, ← map_pow, modularIntegral_ST_pow_three,
    modularTraceProjectiveQuotientMap_neg_one]

/-- In a commuting modular quotient, the order-two generator is the
inverse cube of the parabolic generator. -/
theorem modularTraceProjectiveQuotientS_eq_inv_T_pow_three :
    modularTraceProjectiveQuotientS = (modularTraceProjectiveQuotientT ^ 3)⁻¹ := by
  have hc : Commute modularTraceProjectiveQuotientS modularTraceProjectiveQuotientT := by
    exact modularTraceProjectiveQuotient_commutative.comm _ _
  have hs3 : modularTraceProjectiveQuotientS ^ 3 = modularTraceProjectiveQuotientS := by
    rw [show 3 = 2 + 1 from rfl, pow_succ, modularTraceProjectiveQuotientS_pow_two, one_mul]
  apply eq_inv_iff_mul_eq_one.mpr
  simpa only [hc.mul_pow, hs3] using modularTraceProjectiveQuotientST_pow_three

theorem modularTraceProjectiveQuotientT_pow_six :
    modularTraceProjectiveQuotientT ^ 6 = 1 := by
  have h := congrArg (fun x : ModularTraceProjectiveQuotient => x ^ 2)
    modularTraceProjectiveQuotientS_eq_inv_T_pow_three
  dsimp only at h
  rw [modularTraceProjectiveQuotientS_pow_two, inv_pow, ← pow_mul] at h
  exact inv_eq_one.mp h.symm

theorem modularTraceProjectiveQuotient_generators :
    Subgroup.closure {modularTraceProjectiveQuotientS, modularTraceProjectiveQuotientT} = ⊤ := by
  change Subgroup.closure {modularTraceProjectiveQuotientMap ModularGroup.S,
    modularTraceProjectiveQuotientMap ModularGroup.T} = ⊤
  rw [← Set.image_pair, ← MonoidHom.map_closure,
    SpecialLinearGroup.SL2Z_generators, ← MonoidHom.range_eq_map,
    MonoidHom.range_eq_top]
  exact modularTraceProjectiveQuotientMap_surjective

/-- Every quotient element is an integral power of the actual image of `T`. -/
theorem modularTraceProjectiveQuotient_zpowers_T_eq_top :
    Subgroup.zpowers modularTraceProjectiveQuotientT = ⊤ := by
  apply top_unique
  rw [← modularTraceProjectiveQuotient_generators]
  apply (Subgroup.closure_le _).mpr
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl
  · rw [modularTraceProjectiveQuotientS_eq_inv_T_pow_three]
    exact (Subgroup.zpowers _).inv_mem
      ((Subgroup.zpowers _).pow_mem (Subgroup.mem_zpowers _) 3)
  · exact Subgroup.mem_zpowers _

instance modularTraceProjectiveQuotient_isCyclic : IsCyclic ModularTraceProjectiveQuotient :=
  isCyclic_iff_exists_zpowers_eq_top.mpr
    ⟨modularTraceProjectiveQuotientT, modularTraceProjectiveQuotient_zpowers_T_eq_top⟩

instance modularTraceProjectiveQuotient_finite : Finite ModularTraceProjectiveQuotient := by
  apply Nat.finite_of_card_ne_zero
  rw [← orderOf_eq_card_of_zpowers_eq_top modularTraceProjectiveQuotient_zpowers_T_eq_top]
  apply orderOf_ne_zero_iff.mpr
  exact isOfFinOrder_iff_pow_eq_one.mpr
    ⟨6, by decide, modularTraceProjectiveQuotientT_pow_six⟩

theorem modularTraceProjectiveQuotient_card_le_six :
    Nat.card ModularTraceProjectiveQuotient ≤ 6 := by
  rw [← orderOf_eq_card_of_zpowers_eq_top modularTraceProjectiveQuotient_zpowers_T_eq_top]
  exact orderOf_le_of_pow_eq_one (by decide) modularTraceProjectiveQuotientT_pow_six

end Markov
